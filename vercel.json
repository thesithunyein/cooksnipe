{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.momoswap.fun/:path*" },
    { "source": "/", "destination": "/landing.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/((?!api/).*)", "destination": "/app.html" }
  ]
}
